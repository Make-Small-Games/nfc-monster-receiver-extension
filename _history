{"entries":[{"timestamp":1792139412268,"editorVersion":"4.1.25","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":131,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <variables></variables>\n  <block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":1,"diffs":[[1," "]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":200,"length1":43,"diffs":[[1,"        \"assets.json\"\n"]]},{"start1":229,"length1":31,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"custom.ts","value":"/**\n * NFC Monster receiver extension.\n *\n * Receives NFC monster data sent over radio\n * by the Make Small Games NFC micro:bit reader.\n */\n\n//% weight=95 color=#6f5cff block=\"NFC Monster\"\nnamespace NFCMonster {\n\n    // ============================================================\n    // PROTOCOL\n    // ============================================================\n\n    const PIXEL_CHARACTERS =\n        \"0123456789ABCDEF\"\n\n    const DATA_CHARACTERS =\n        \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    const FACING_CODES =\n        \"LFR\"\n\n    const ROW_CODES =\n        \"ABCDEFGHIJKLMNOP\"\n\n\n    // ============================================================\n    // RECEIVER STATE\n    // ============================================================\n\n    let Receiver_Started =\n        false\n\n    let Radio_Group =\n        42\n\n\n    // ------------------------------------------------------------\n    // INCOMING MONSTER\n    //\n    // This is kept separate from the last completed monster.\n    //\n    // If a new transmission fails, the previously received\n    // monster remains available to the game.\n    // ------------------------------------------------------------\n\n    let Incoming_Rows: string[] =\n        []\n\n    let Incoming_Row_Received: boolean[] =\n        []\n\n    let Incoming_Rows_Received =\n        0\n\n    let Incoming_Metadata_Received =\n        false\n\n    let Incoming_Facing =\n        \"\"\n\n    let Incoming_Type =\n        \"\"\n\n    let Incoming_Health =\n        0\n\n    let Incoming_Attack =\n        0\n\n    let Incoming_Speed =\n        0\n\n    let Incoming_Reserved =\n        \"\"\n\n\n    // ============================================================\n    // LAST COMPLETE MONSTER\n    // ============================================================\n\n    let Last_Monster_Image: Image =\n        null\n\n    let Last_Monster_Facing =\n        \"\"\n\n    let Last_Monster_Type =\n        \"\"\n\n    let Last_Monster_Health =\n        0\n\n    let Last_Monster_Attack =\n        0\n\n    let Last_Monster_Speed =\n        0\n\n    let Last_Monster_Reserved =\n        \"\"\n\n    let Monster_Available =\n        false\n\n\n    // ============================================================\n    // EVENT HANDLERS\n    // ============================================================\n\n    let Received_Handlers: (() => void)[] =\n        []\n\n\n    // ============================================================\n    // RESET INCOMING DATA\n    // ============================================================\n\n    function resetIncomingMonster() {\n\n        Incoming_Rows =\n            []\n\n        Incoming_Row_Received =\n            []\n\n        Incoming_Rows_Received =\n            0\n\n        Incoming_Metadata_Received =\n            false\n\n        Incoming_Facing =\n            \"\"\n\n        Incoming_Type =\n            \"\"\n\n        Incoming_Health =\n            0\n\n        Incoming_Attack =\n            0\n\n        Incoming_Speed =\n            0\n\n        Incoming_Reserved =\n            \"\"\n\n\n        for (\n            let row = 0;\n            row < 16;\n            row++\n        ) {\n\n            Incoming_Rows.push(\n                \"\"\n            )\n\n            Incoming_Row_Received.push(\n                false\n            )\n\n        }\n\n    }\n\n\n    // ============================================================\n    // CONVERT PIXEL CHARACTER TO COLOR\n    // ============================================================\n\n    function pixelCharacterToColor(\n        character: string\n    ) {\n\n        return PIXEL_CHARACTERS.indexOf(\n            character.toUpperCase()\n        )\n\n    }\n\n\n    // ============================================================\n    // CONVERT 0-Z CHARACTER TO NUMBER\n    //\n    // 0-9 = 0-9\n    // A   = 10\n    // B   = 11\n    // ...\n    // Z   = 35\n    // ============================================================\n\n    function dataCharacterToNumber(\n        character: string\n    ) {\n\n        return DATA_CHARACTERS.indexOf(\n            character.toUpperCase()\n        )\n\n    }\n\n\n    // ============================================================\n    // CHECK GENERIC DATA CHARACTER\n    // ============================================================\n\n    function validDataCharacter(\n        character: string\n    ) {\n\n        return DATA_CHARACTERS.indexOf(\n            character.toUpperCase()\n        ) >= 0\n\n    }\n\n\n    // ============================================================\n    // CHECK SPRITE ROW\n    // ============================================================\n\n    function validRow(\n        pixels: string\n    ) {\n\n        if (\n            pixels.length != 16\n        ) {\n\n            return false\n\n        }\n\n\n        for (\n            let x = 0;\n            x < 16;\n            x++\n        ) {\n\n            let color =\n                pixelCharacterToColor(\n                    pixels.substr(\n                        x,\n                        1\n                    )\n                )\n\n\n            if (\n                color < 0 ||\n                color > 15\n            ) {\n\n                return false\n\n            }\n\n        }\n\n\n        return true\n\n    }\n\n\n    // ============================================================\n    // READ METADATA\n    //\n    // 13 characters:\n    //\n    // Facing\n    // Type\n    // Health\n    // Attack\n    // Speed\n    // 8 reserved characters\n    // ============================================================\n\n    function readMetadata(\n        metadata: string\n    ) {\n\n        metadata =\n            metadata.toUpperCase()\n\n\n        if (\n            metadata.length != 13\n        ) {\n\n            return false\n\n        }\n\n\n        let facing =\n            metadata.substr(\n                0,\n                1\n            )\n\n\n        if (\n            FACING_CODES.indexOf(\n                facing\n            ) < 0\n        ) {\n\n            return false\n\n        }\n\n\n        let type =\n            metadata.substr(\n                1,\n                1\n            )\n\n\n        if (\n            !(validDataCharacter(\n                type\n            ))\n        ) {\n\n            return false\n\n        }\n\n\n        let healthCharacter =\n            metadata.substr(\n                2,\n                1\n            )\n\n        let attackCharacter =\n            metadata.substr(\n                3,\n                1\n            )\n\n        let speedCharacter =\n            metadata.substr(\n                4,\n                1\n            )\n\n\n        if (\n            !(validDataCharacter(\n                healthCharacter\n            ))\n        ) {\n\n            return false\n\n        }\n\n\n        if (\n            !(validDataCharacter(\n                attackCharacter\n            ))\n        ) {\n\n            return false\n\n        }\n\n\n        if (\n            !(validDataCharacter(\n                speedCharacter\n            ))\n        ) {\n\n            return false\n\n        }\n\n\n        let reserved =\n            metadata.substr(\n                5,\n                8\n            )\n\n\n        for (\n            let position = 0;\n            position < 8;\n            position++\n        ) {\n\n            if (\n                !(validDataCharacter(\n                    reserved.substr(\n                        position,\n                        1\n                    )\n                ))\n            ) {\n\n                return false\n\n            }\n\n        }\n\n\n        Incoming_Facing =\n            facing\n\n        Incoming_Type =\n            type\n\n        Incoming_Health =\n            dataCharacterToNumber(\n                healthCharacter\n            )\n\n        Incoming_Attack =\n            dataCharacterToNumber(\n                attackCharacter\n            )\n\n        Incoming_Speed =\n            dataCharacterToNumber(\n                speedCharacter\n            )\n\n        Incoming_Reserved =\n            reserved\n\n        Incoming_Metadata_Received =\n            true\n\n\n        return true\n\n    }\n\n\n    // ============================================================\n    // BUILD MONSTER IMAGE\n    // ============================================================\n\n    function buildMonsterImage() {\n\n        let monsterImage =\n            image.create(\n                16,\n                16\n            )\n\n\n        for (\n            let y = 0;\n            y < 16;\n            y++\n        ) {\n\n            let row =\n                Incoming_Rows[y]\n\n\n            for (\n                let x = 0;\n                x < 16;\n                x++\n            ) {\n\n                let character =\n                    row.substr(\n                        x,\n                        1\n                    )\n\n\n                let color =\n                    pixelCharacterToColor(\n                        character\n                    )\n\n\n                monsterImage.setPixel(\n                    x,\n                    y,\n                    color\n                )\n\n            }\n\n        }\n\n\n        return monsterImage\n\n    }\n\n\n    // ============================================================\n    // FINISH MONSTER\n    // ============================================================\n\n    function finishMonster() {\n\n        if (\n            Incoming_Rows_Received != 16\n        ) {\n\n            return\n\n        }\n\n\n        if (\n            !(Incoming_Metadata_Received)\n        ) {\n\n            return\n\n        }\n\n\n        // --------------------------------------------------------\n        // Only now replace the last completed monster.\n        // --------------------------------------------------------\n\n        Last_Monster_Image =\n            buildMonsterImage()\n\n        Last_Monster_Facing =\n            Incoming_Facing\n\n        Last_Monster_Type =\n            Incoming_Type\n\n        Last_Monster_Health =\n            Incoming_Health\n\n        Last_Monster_Attack =\n            Incoming_Attack\n\n        Last_Monster_Speed =\n            Incoming_Speed\n\n        Last_Monster_Reserved =\n            Incoming_Reserved\n\n        Monster_Available =\n            true\n\n\n        // --------------------------------------------------------\n        // Tell any game code that a complete monster arrived.\n        // --------------------------------------------------------\n\n        for (\n            let index = 0;\n            index < Received_Handlers.length;\n            index++\n        ) {\n\n            Received_Handlers[index]()\n\n        }\n\n    }\n\n\n    // ============================================================\n    // HANDLE RADIO MESSAGE\n    // ============================================================\n\n    function handleRadioMessage(\n        message: string\n    ) {\n\n        message =\n            message.toUpperCase()\n\n\n        // --------------------------------------------------------\n        // START\n        // --------------------------------------------------------\n\n        if (\n            message == \"S\"\n        ) {\n\n            resetIncomingMonster()\n\n            return\n\n        }\n\n\n        // --------------------------------------------------------\n        // END\n        // --------------------------------------------------------\n\n        if (\n            message == \"E\"\n        ) {\n\n            finishMonster()\n\n            return\n\n        }\n\n\n        // --------------------------------------------------------\n        // METADATA\n        //\n        // Q + 13 characters\n        // --------------------------------------------------------\n\n        if (\n            message.substr(\n                0,\n                1\n            ) == \"Q\"\n        ) {\n\n            if (\n                message.length != 14\n            ) {\n\n                return\n\n            }\n\n\n            readMetadata(\n                message.substr(\n                    1,\n                    13\n                )\n            )\n\n\n            return\n\n        }\n\n\n        // --------------------------------------------------------\n        // SPRITE ROW\n        //\n        // A-P + 16 pixel characters\n        // --------------------------------------------------------\n\n        if (\n            message.length != 17\n        ) {\n\n            return\n\n        }\n\n\n        let rowCode =\n            message.substr(\n                0,\n                1\n            )\n\n\n        let row =\n            ROW_CODES.indexOf(\n                rowCode\n            )\n\n\n        if (\n            row < 0 ||\n            row > 15\n        ) {\n\n            return\n\n        }\n\n\n        let pixels =\n            message.substr(\n                1,\n                16\n            )\n\n\n        if (\n            !(validRow(\n                pixels\n            ))\n        ) {\n\n            return\n\n        }\n\n\n        if (\n            !(Incoming_Row_Received[\n                row\n            ])\n        ) {\n\n            Incoming_Row_Received[\n                row\n            ] =\n                true\n\n            Incoming_Rows_Received +=\n                1\n\n        }\n\n\n        Incoming_Rows[\n            row\n        ] =\n            pixels\n\n    }\n\n\n    // ============================================================\n    // START RADIO RECEIVER\n    //\n    // Only starts once.\n    // ============================================================\n\n    function ensureReceiverStarted() {\n\n        if (\n            Receiver_Started\n        ) {\n\n            return\n\n        }\n\n\n        Receiver_Started =\n            true\n\n\n        resetIncomingMonster()\n\n\n        radio.onReceivedString(\n            function (message) {\n\n                handleRadioMessage(\n                    message\n                )\n\n            }\n        )\n\n    }\n\n\n    // ============================================================\n    // PUBLIC BLOCKS\n    // ============================================================\n\n\n    /**\n     * Sets the radio group used by the NFC Monster receiver.\n     */\n    //% blockId=nfcmonster_set_radio_group\n    //% block=\"NFC Monster set radio group $radioGroup\"\n    //% radioGroup.defl=42\n    //% radioGroup.min=0\n    //% radioGroup.max=255\n    //% weight=100\n    export function setRadioGroup(\n        radioGroup: number\n    ) {\n\n        ensureReceiverStarted()\n\n\n        Radio_Group =\n            radioGroup\n\n\n        radio.setGroup(\n            Radio_Group\n        )\n\n\n        radio.setTransmitPower(\n            7\n        )\n\n    }\n\n\n    /**\n     * Runs when a complete NFC monster is received.\n     */\n    //% blockId=nfcmonster_on_received\n    //% block=\"on NFC monster received\"\n    //% weight=95\n    export function onMonsterReceived(\n        handler: () => void\n    ) {\n\n        ensureReceiverStarted()\n\n\n        Received_Handlers.push(\n            handler\n        )\n\n    }\n\n\n    /**\n     * Returns true after at least one complete monster has been received.\n     */\n    //% blockId=nfcmonster_has_monster\n    //% block=\"NFC monster available\"\n    //% weight=90\n    export function hasMonster() {\n\n        return Monster_Available\n\n    }\n\n\n    /**\n     * Returns the last received monster image.\n     */\n    //% blockId=nfcmonster_image\n    //% block=\"NFC monster image\"\n    //% weight=85\n    export function monsterImage() {\n\n        if (\n            Last_Monster_Image\n        ) {\n\n            return Last_Monster_Image\n\n        }\n\n\n        return image.create(\n            16,\n            16\n        )\n\n    }\n\n\n    /**\n     * Returns L, F, or R.\n     */\n    //% blockId=nfcmonster_facing\n    //% block=\"NFC monster facing\"\n    //% weight=80\n    export function facing() {\n\n        return Last_Monster_Facing\n\n    }\n\n\n    /**\n     * Returns the one-character monster type code.\n     */\n    //% blockId=nfcmonster_type\n    //% block=\"NFC monster type\"\n    //% weight=75\n    export function type() {\n\n        return Last_Monster_Type\n\n    }\n\n\n    /**\n     * Returns the monster Health stat.\n     */\n    //% blockId=nfcmonster_health\n    //% block=\"NFC monster health\"\n    //% weight=70\n    export function health() {\n\n        return Last_Monster_Health\n\n    }\n\n\n    /**\n     * Returns the monster Attack stat.\n     */\n    //% blockId=nfcmonster_attack\n    //% block=\"NFC monster attack\"\n    //% weight=65\n    export function attack() {\n\n        return Last_Monster_Attack\n\n    }\n\n\n    /**\n     * Returns the monster Speed stat.\n     */\n    //% blockId=nfcmonster_speed\n    //% block=\"NFC monster speed\"\n    //% weight=60\n    export function speed() {\n\n        return Last_Monster_Speed\n\n    }\n\n\n    /**\n     * Returns all eight reserved future characters.\n     */\n    //% blockId=nfcmonster_reserved\n    //% block=\"NFC monster reserved data\"\n    //% weight=55\n    export function reservedData() {\n\n        return Last_Monster_Reserved\n\n    }\n\n\n    /**\n     * Returns one reserved field, numbered 1 through 8.\n     */\n    //% blockId=nfcmonster_extra_field\n    //% block=\"NFC monster extra field $field\"\n    //% field.defl=1\n    //% field.min=1\n    //% field.max=8\n    //% weight=50\n    export function extraField(\n        field: number\n    ) {\n\n        if (\n            field < 1 ||\n            field > 8\n        ) {\n\n            return \"\"\n\n        }\n\n\n        return Last_Monster_Reserved.substr(\n            field - 1,\n            1\n        )\n\n    }\n\n}"}]},{"timestamp":1792139441723,"editorVersion":"4.1.25","changes":[],"event":{"type":"extension-added","extensionName":"radio-broadcast","phase":"before"}},{"timestamp":1792139441724,"editorVersion":"4.1.25","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":93,"length1":54,"diffs":[[1,"        \"device\": \"*\"\n"]]}]}],"event":{"type":"extension-added","extensionName":"radio-broadcast","phase":"after"}},{"timestamp":1792139441725,"editorVersion":"4.1.25","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":133,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block></xml>"]]}]}]},{"timestamp":1792139445618,"editorVersion":"4.1.25","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":133,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"10\" y=\"10\"></block></xml>"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":2,"length1":140,"diffs":[[1,"    \"name\": \"NFC Monster Reciever Extension\",\n    \"description\": \"\",\n"]]},{"start1":169,"length1":86,"diffs":[[1,""]]},{"start1":192,"length1":22,"diffs":[[1,"        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"custom.ts\"\n"]]},{"start1":282,"length1":50,"diffs":[[1,""]]}]}]},{"timestamp":1792140010266,"editorVersion":"4.1.25","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":159,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":32,"diffs":[[1,""]]},{"start1":1,"length1":678,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":349,"length1":41,"diffs":[[1,"        \"assets.json\"\n"]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]}],"snapshots":[{"timestamp":1792139412267,"editorVersion":"4.1.25","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <variables></variables>\n  <block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block>\n</xml>","main.ts":" ","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"NFC Monster Reciever Extension\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}}],"shares":[],"lastSaveTime":1792140413076}